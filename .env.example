# Copy this file to .env and fill in your own values. .env itself is
# gitignored -- never commit real credentials.

# Postgres connection string (this project is built against Neon, but any
# Postgres instance works). Grab this from your Neon project's dashboard,
# or your own Postgres instance's own connection string.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
